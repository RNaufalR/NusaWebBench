# Salin ke .env untuk pengembangan lokal. JANGAN commit file .env.
# Semua nilai di bawah adalah default aman / placeholder. Tidak ada API key nyata di sini.

NODE_ENV=development
HOST=127.0.0.1
PORT=4178
DATABASE_PATH=./data/nusawebbench.sqlite
ARTIFACTS_DIR=./data/artifacts

FREE_TIER_LOCK=true
AI_PROVIDER=none
AI_FALLBACK_ENABLED=false
AI_ALLOW_EXTERNAL_DATA=false
AI_MAX_REQUESTS_PER_RUN=3
AI_MAX_REQUESTS_PER_DAY=20
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_IMAGE_BYTES=1500000
AI_MAX_IMAGES_PER_RUN=3

# Kosongkan jika tidak dipakai. Isi hanya di file .env lokal Anda.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

STRIX_ENABLED=false
K6_ENABLED=false
LOW_RESOURCE_MODE=true

# Opsional (tidak punya nilai default yang berisi rahasia).
# CHROMIUM_PATH=/path/ke/chromium
# K6_BIN=/path/ke/k6
# NWB_CHROME_NO_SANDBOX=0
# ALLOWED_HOSTS=
